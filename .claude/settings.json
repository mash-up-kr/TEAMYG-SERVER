{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(./gradlew build *)",
      "Bash(./gradlew test *)",
      "Bash(./gradlew ktlintCheck *)",
      "Bash(./gradlew ktlintFormat *)",
      "Read",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*credentials*)",
      "Read(**/*secret*)"
    ]
  }
}
