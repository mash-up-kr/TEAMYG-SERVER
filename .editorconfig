root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{kt,kts}]
max_line_length = 120
ktlint_standard_no-wildcard-imports = enabled
ktlint_standard_import-ordering = enabled
ktlint_standard_filename = enabled

[*.{yml,yaml}]
indent_size = 2

[*.{json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false